# OPTIONAL HOLY PALADIN DEFAULT: replace matching active Tier 1 Paladin entries.
# This example is not loaded automatically; Retribution remains the default.
# Uses caster plate at all brackets via the native low-level heirloom exception.
# Requires the current module build for planned one-handed main/offhand validation.
# Keep the one-handed mace BEFORE the held tome in the configured item order.
# The tome is a held caster offhand, not a shield; no block/armor is assigned to it.
# Existing completed grants are not repeated. No role-selection UI is introduced.

[worldserver]

