[worldserver]

# Master switch. Disabling removes enforcement as well as selection.
# Do not disable on a live server with a restricted economy without planning it.
BattlegroundMode.Enable = 1

# New level 1 characters only. Characters above level 1 are ineligible and
# remain normal, including classes/server configurations that start above 1.
# Existing characters without a record remain normal.
# Closing the menu allows normal XP gain. At level 1, .bgmode opens it again.
# Reaching level 2 permanently selects Normal Mode automatically.
BattlegroundMode.PromptOnLogin = 1
BattlegroundMode.AllowNormal = 1

# Up to 31 distinct comma-separated levels, 1..80 and <= the server maximum.
# Invalid lists disable
# Battleground Mode selection, with an error in the server log. No downleveling.
# Existing permanent decisions survive edits to this list.
BattlegroundMode.AllowedLevels = "19,29,39,49,59,69,79"

# Learn normal class-trainer spells for the chosen level, free of training fees.
# Runs on bracket selection and the next safe login for existing BG characters.
# Uses core race/class, level, skill, and spell-prerequisite checks. Does not
# award talent points, select talents, or grant quest-only spells/professions.
# Already-known spells are skipped; disabling does not unlearn earlier grants.
BattlegroundMode.AutoLearnClassTrainerSpells = 1

BattlegroundMode.RestoreHealthMana = 1
BattlegroundMode.TeleportOnSelection = 1
# Both factions: default brackets 19/29/39/49/59/69 go to Shattrath;
# level 79 goes to Dalaran. For custom brackets, levels below MinLevel use
# Shattrath; levels at or above it use Dalaran (MinLevel is clamped to 1..80).
# Applies once when selecting BG mode; existing characters are not moved on login.
# Replaces the old Alliance/Horde destination settings, which are no longer used.
BattlegroundMode.Teleport.Dalaran.MinLevel = 79
BattlegroundMode.Teleport.Shattrath.Map = 530
BattlegroundMode.Teleport.Shattrath.X = -1838.16
BattlegroundMode.Teleport.Shattrath.Y = 5301.79
BattlegroundMode.Teleport.Shattrath.Z = -12.428
BattlegroundMode.Teleport.Shattrath.O = 5.0
BattlegroundMode.Teleport.Dalaran.Map = 571
BattlegroundMode.Teleport.Dalaran.X = 5807.75
BattlegroundMode.Teleport.Dalaran.Y = 588.347
BattlegroundMode.Teleport.Dalaran.Z = 660.939
BattlegroundMode.Teleport.Dalaran.O = 1.64

# Stock Horde and Alliance vendor rows and banners at the supplied hub locations.
# Installed automatically by the core startup database updater (Updates.EnableDatabases = 7).
# 1: allow the location's copies to spawn. 0: hide BOTH factions' copies AND banners.
# Worldserver RESTART required after changing these settings (.reload is not enough).
# Only module-tagged hub spawns are affected; original vendors stay in place.
# Master Enable = 0 also suppresses both hubs at the next restart.
BattlegroundMode.VendorHubs.Shattrath.Enable = 1
BattlegroundMode.VendorHubs.Dalaran.Enable = 1

# Per-character restrictions, also applied while a new character is undecided.
# Normal characters on the same account are unaffected. Disabling any of these
# opens value-transfer paths. Ordinary AH purchases pay the auction's owner.
BattlegroundMode.BlockTrading = 1
BattlegroundMode.BlockSendingMail = 1
# Blocks player mail addressed to these characters, plus taking/returning mail.
# System mail can still arrive, but its attachments cannot be collected.
BattlegroundMode.BlockReceivingMail = 1
BattlegroundMode.BlockAuctionHouse = 1
BattlegroundMode.BlockGuildBank = 1

# One-time Tier 1 delivery. Existing BG characters receive an unclaimed set on
# their next safe login. Later config edits never overwrite a completed grant.
BattlegroundMode.StarterGear.Enable = 1
# 1: equip every configured piece, swapping replaced equipment into the bags.
# 0: deliver the set into the bags without changing equipped gear.
BattlegroundMode.StarterGear.AutoEquip = 1
# Teach only the class's legal mail/plate proficiency at level 40+, as needed.
BattlegroundMode.StarterGear.TrainArmorProficiency = 1
# Soulbind new starter pieces to the receiving character.
BattlegroundMode.StarterGear.BindToCharacter = 1
# Keep enough free bag slots for the WHOLE starter set before delivery. Nothing
# is deleted to make room. If blocked, fix the problem and use .bgstarter to retry.
# Character SQL is applied automatically by the core startup database updater;
# it handles fresh installations and upgrades without resetting saved choices.

# ============================================================================
# GEAR CATALOG: bracket -> tier -> class -> itemID:honorPrice
# ============================================================================
# Tier 1: Starter (free). Tier 2: Soldier. Tier 3: Veteran.
# Tier 4: Champion. Tier 5: Elite (reserved for further curated/custom upgrades).
# Syntax: "itemID:honorPrice,itemID:honorPrice". Prices are per individual item.
# Example: "12982:75,6460:100" means 75 honor for boots, 100 for the belt.
# Tier 1 prices MUST be 0. Tier 2+ prices MUST be positive and <= the honor cap.
# Empty lists are intentional: they supply no starter/vendor items.
# Add any Tier6 (or higher) class key below; the loader discovers it automatically.
# No TierCount or code change is needed. Tier IDs range from 1 to 65535.
# Settings reload with .reload config. The catalog preview command is:
# .bggear <tier> lists the logged-in BG character's exact bracket/class and prices.
# Tier 1 is delivered once using the StarterGear settings above. Vendor purchasing
# and honor deductions are NOT wired yet.
# No starting gold or talent grants are provided here. Class-trainer spells
# are controlled separately by AutoLearnClassTrainerSpells above.
#
# These are STOCK item candidates, NOT playtested complete sets at every tier.
# Tier 1 contains core armor. Level 19 has no head item. Weapons, cloaks, jewelry,
# and trinkets are not included. Higher tiers contain upgrade options, not full kits.
# Empty later tiers must be filled before exposing them in the future vendor.
# Green starter items receive normal random stat affixes from the core's pools.
# Role-specific fixed affixes are not implemented.
# Default Druid/Shaman/Paladin lists favor physical roles; caster/healer variants
# need separate role design or administrator edits. Death Knight lists are empty
# because characters starting above level 1 are ineligible for BG enrollment.
# Stock items retain resale/disenchant values. Zero-value custom copies or item
# restrictions will be needed if those actions must be prohibited for starter gear.
# Honor prices below are initial editable balance suggestions, not tuned rewards.
# Source/item details: docs/starter-gear.md and docs/starter-gear-candidates.csv.

